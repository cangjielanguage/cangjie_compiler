package arkts.lang

// arkts.lang maps the ArkTS/TS standard library: it mirrors standard-library
// types and functions and re-exports the interop API, the call-scope ABI v1
// entries and BigInt. The declaration packages (arkts.lang for the TS standard
// library, arkts.ohos for @ohos.* and @kit.*) are generated by HLE and
// published as third-party libraries. Neither provides ArkTSArray<T> or
// ArkTSString: those presets of std.interop.arkts are recognised by their
// declaring package, so a position spelled with them reports the deferral
// diagnostic while every same-named declaration stays unsupported.
public import ohos.ark_interop.*
public import cj_arkts_context_v1.__cj_arkts_enter
public import cj_arkts_context_v1.__cj_arkts_current
public import cj_arkts_context_v1.__cj_arkts_restore
public import std.math.numeric.BigInt
// ArkTSArray<T> is the stdlib preset of std.interop.arkts, re-exported here so
// the name stays reachable through the arkts.lang import applications already
// use; a public import preserves the declaring package of the re-exported type.
// The compiler does not map this type yet: its reference semantics is deferred,
// so such positions are rejected with the deferral diagnostic.
public import std.interop.arkts.*

// ============================================================================
// ExternConversionException: the documented conversion exception
//
// Cross-boundary conversion failures need a named exception whose message
// distinguishes "type mismatch" from "invalid value". The authoritative design
// defines ExternConversionException together with the Extern mechanism, whose
// provider this toolchain does not ship yet; this declaration is that facade -
// a bare exception type whose name and single-String constructor are the
// compiler-side contract the generated conversion points throw. No conversion
// logic lives here.
// ============================================================================
public class ExternConversionException <: Exception {
    public init(message: String) {
        super(message)
    }
}
