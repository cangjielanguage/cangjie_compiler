+def DeletePrefixOfTypename(type_name, prefix):
+    if type_name is None:
+        return ""
+    while type_name.find(prefix) != -1:
+        index = type_name.find(prefix)
+        type_name = type_name[:index] + type_name[index + len(prefix):]
+    return type_name
