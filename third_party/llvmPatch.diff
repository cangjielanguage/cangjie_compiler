+  unreachable
+
+inf.or.nan:                                       ; preds = %fp.convert.exception
+  tail call void @CJ_MCC_ThrowException()
+  unreachable
+
+normal1:                                          ; preds = %bb11, %lower.bound.ok
+  %divisor_is_0 = icmp eq i64 %fptosi1, 0
