+    auto Derived = dyn_cast<Value>(
+        *(cast<GCStatepointInst>(GCReloc->getStatepoint())->gc_args_begin() +
+          GCReloc->getDerivedPtrIndex()));
+    OS << Base->getName() << ", %";
