+bool CangjieASTBuiler::IsFunctionType(ConstString type_name)
+{
+  ConstString compare("(.+::|^)\\(.*\\)( ?)->.+$");
+  RegularExpression regex(compare.GetStringRef());
+  return regex.Execute(type_name.AsCString());
+}
