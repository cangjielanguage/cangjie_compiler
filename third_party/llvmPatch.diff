+  %2 = bitcast %record2* %1 to i8*
+  call void @llvm.memcpy.p0i8.p0i8.i64(i8* align 8 %2, i8* align 8 %arg1, i64 80, i1 false)
+  call void @test_func()
+  br label %bb2
