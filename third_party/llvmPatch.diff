+declare void @llvm.memset.p0i8.i64(i8* nocapture writeonly, i8, i64, i1 immarg)
+
+declare i64 @tmp_use() gc "cangjie"
+declare void @test(%struct_1 addrspace(1)* %arg0) gc "cangjie"
