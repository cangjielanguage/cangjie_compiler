+  using DefOffsetMap = DenseMap<int, SmallSetVector<GCPtr *, 8>>;
+  using DefBaseMap = DenseMap<Value *, DefOffsetMap>;
+  using DefBBMap = std::map<BasicBlock *, DefBaseMap>;
