+InstrLiveIntervalConflictGraph::InstrLiveIntervalConflictGraph(
+    SmallVector<CallBase *, 4> &SmallSizeCB,
+    ValueToLiveInterval &LiveIntervalMap) {
+  for (auto U : SmallSizeCB) {
+    Nodes.push_back(new InstrWithLiveIntervalNode(U));
+  }
+
+  for (auto U : Nodes) {
+    for (auto V : Nodes) {
+      if (U != V && LiveIntervalMap.count(U->Instr) &&
+          LiveIntervalMap.count(V->Instr) &&
+          FunctionVarLifeTimeResult::overlapLifeInterval(
+              LiveIntervalMap[U->Instr], LiveIntervalMap[V->Instr])) {
+        U->AdjacentInstrs.insert(V);
+        V->AdjacentInstrs.insert(U);
+      }
+    }
+  }
+}
