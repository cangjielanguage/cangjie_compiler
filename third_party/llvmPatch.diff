+    SmallSet<StructType *, 8> STs;
+    getAllStructTypes(Ptr, STs);
+    for (auto *ST : STs)
+      if (ST && (!ST->hasName() || (ST->getName().contains("Option") ||
+                                    ST->getName().contains("Enum"))))
+        return true;
+  }
+  return false;
+}
