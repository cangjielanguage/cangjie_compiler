+GlobalVariable *getNewKlass(CallBase *I) {
+  GlobalVariable *Klass =
+      dyn_cast<GlobalVariable>(I->getArgOperand(0)->stripPointerCasts());
+  if (Klass && (Klass->getMetadata("RelatedType") != 0)) {
+    return Klass;
+  }
+  return nullptr;
+}
