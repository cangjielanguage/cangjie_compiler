+void TraceFixEvent(TracePart *part, Event *end, uptr from, uptr to, uptr size) {
+  for (Event *evp = &part->events[0]; evp < end; evp++) {
+    if (evp->is_access) {
+      if (evp->is_func == 0 && evp->type == EventType::kAccessExt &&
