+def RemoveOuterQuotes(s: str) -> str:
+    if len(s) < 2 or s[0] != '"' or s[-1] != '"':
+        return s
+    start, end = 0, len(s)
+    while start < end and s[start] == '"':
+        start += 1
+    while end > start and s[end - 1] == '"':
+        end -= 1
+    return s[start:end]
