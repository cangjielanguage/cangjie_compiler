+        appendIndex = self.valobj.GetChildMemberWithName("appendIndex")
+        freeSize = self.valobj.GetChildMemberWithName("freeSize")
+        self.numEntries = appendIndex.GetValueAsSigned() - freeSize.GetValueAsSigned()
