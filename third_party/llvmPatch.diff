+StructType *llvm::getTypeLayoutType(GlobalVariable *GV) {
+  const MDNode *Metadata = GV->getMetadata("RelatedType");
+  if (!Metadata)
+    return nullptr;
+
+  StringRef TypeName =
+      dyn_cast<MDString>(Metadata->getOperand(0).get())->getString();
