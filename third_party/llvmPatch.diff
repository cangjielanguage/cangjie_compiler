+std::string lldb_private::GetPkgNameFromCompilerUnit(const CompileUnit& compUnit)
+{
+  std::string diFileName = SafeAsCString(compUnit.GetPrimaryFile().GetFilename());
+  return diFileName.substr(diFileName.find('-') + 1);
+}
