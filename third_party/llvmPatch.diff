+}
+
+void ObfConfig::loadConfig(const std::string &ConfigPath) {
+  std::string Line;
+  std::ifstream InputFile(ConfigPath);
+
+  if (!InputFile.is_open()) {
+    return;
+  }
+
+  while (getline(InputFile, Line)) {
+    std::string NewLine = "";
+    for (auto C : Line) {
+      if (C == '#') {
+        break;
+      }
+      NewLine += C;
+    }
+    if (NewLine.size() == 0) {
+      continue;
+    }
+
+    Rule R = Rule::get(Line);
+    addRule(R);
+  }
+
+  InputFile.close();
+}
