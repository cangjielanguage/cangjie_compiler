+    OwnedPtr<AST::FuncDecl> CreateEnumFuncDecl(const CompilerType &enumType, const CompilerType &ctorType,
+                                           std::string name, Ptr<AST::Decl> pdecl = nullptr);
+    OwnedPtr<AST::FuncDecl> CreateFuncDecl(
