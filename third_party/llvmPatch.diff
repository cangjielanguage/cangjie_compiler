+static bool mayBeSafepoint(Instruction *Inst) {
+  if (auto CI = dyn_cast<CallBase>(Inst)) {
+    if (CI->getIntrinsicID() == Intrinsic::cj_gc_statepoint) {
+      return true;
+    }
+  }
+  return false;
