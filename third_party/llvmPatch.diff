+HdcClient::HdcClient(const std::string &connect_addr,
+                     const std::string &device_id)
+    : m_device_id(device_id), m_connect_addr(connect_addr) {}
+
+HdcClient::HdcClient(HdcClient &&) = default;
+
+HdcClient::~HdcClient() = default;
