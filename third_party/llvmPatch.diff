+std::string llvm::getPrimitiveTypeName(Type *Ty) {
+  if (auto PT = dyn_cast<PointerType>(Ty)) {
+    if (PT->getElementType()->isIntegerTy(8)) {
+      if (PT->getAddressSpace() == 1) {
+        return "array_ref";
+      } else {
+        return "array_cptr";
+      }
+    }
+    if (PT->getElementType()->isFunctionTy()) {
+      return "array_cfunc";
+    }
+  }
+  if (Ty->isIntegerTy()) {
+    switch (Ty->getIntegerBitWidth()) {
+    default:
+      break;
+    case 1:
+      return "array_bool";
+    case 8:
+      return "array_int8";
+    case 16:
+      return "array_int16";
+    case 32:
+      return "array_int32";
+    case 64:
+      return "array_int64";
+    }
+  }
+  if (Ty->is16bitFPTy()) {
+    return "array_float16";
+  }
+  if (Ty->isFloatTy()) {
+    return "array_float32";
+  }
+  if (Ty->isDoubleTy()) {
+    return "array_float64";
+  }
+  if (Ty->isStructTy()) {
+    return Ty->getStructName().str();
+  }
+  report_fatal_error("Other type for array to adapt!");
+}
