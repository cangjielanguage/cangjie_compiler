+                   DAG.getDataLayout(), Reg, RetTy, None);
+  SDValue Chain = DAG.getRoot();
+  RFV.getCopyToRegs(Relocated, DAG, getCurSDLoc(), Chain, nullptr);
+  PendingExports.push_back(Chain);
+
+  VirtRegs[SD] = Reg;
